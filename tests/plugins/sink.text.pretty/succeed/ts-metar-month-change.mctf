--- metadata
/* CTF 1.8 */


trace {
    major = 1;
    minor = 8;
    byte_order = le;
};

clock {
    name = c;
    freq = 1000000000;
    absolute = true;
    offset = 0;
    offset_s = 1351532897;
};

stream {
    event.header := struct {
        integer { size = 8; align = 8; signed = false; byte_order = le; } id;
        integer { size = 64; align = 8; signed = false; byte_order = le; map = clock.c.value; } timestamp;
    };
};

event {
    id = 0;
    name = "e";
    fields := struct {
        integer { size = 8; align = 8; signed = false; byte_order = le; base = hexadecimal; } v;
    };
};

--- stream
# event 1: 2012-10-31T23:59:59.999999999Z
$0                        # `id`
[195102999999999:64le]    # `timestamp`
ab                        # `v`

# event 2: 2012-11-01T00:00:00Z (next month)
$0                        # `id`
[195103000000000:64le]    # `timestamp`
ab                        # `v`

# event 3: 2012-11-29T17:48:17.587654321Z (same as a month before)
$0                        # `id`
[2678400587654321:64le]   # `timestamp`
ab                        # `v`

--- @params
{
  "ts-format": {
    "type": "metar"
  },
  "no-delta": true
}

--- @output
[312359Z] e: { v = 0xAB }
[010000Z] e: { v = 0xAB }
[291748Z] e: { v = 0xAB }
