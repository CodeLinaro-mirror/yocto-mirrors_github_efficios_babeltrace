--- metadata
/* CTF 1.8 */

trace {
    major = 1;
    minor = 8;
    byte_order = le;
};

stream {
    event.header := struct {
        integer { size = 8; align = 8; signed = false; byte_order = le; } id;
    };
    event.context := struct {
        integer { size = 8; align = 8; signed = false; byte_order = le; base = decimal; } cc;
    };
};

event {
    id = 0;
    name = "e";
};

--- stream
$0 $2

--- @params
name-scope=yes

--- @output
e: stream.event.context = { cc = 2 }
