--- metadata
/* CTF 1.8 */

trace {
    major = 1;
    minor = 8;
    byte_order = le;
};

event {
    name = "e";
    fields := struct {
        enum : integer { size = 8; align = 8; signed = false; byte_order = le; base = decimal; } {
            A = 0,
            B = 1,
            C = 2 ... 4
        } v;
    };
};

--- stream
$3

--- @output
e: { v = ( "C" : container = 3 ) }
