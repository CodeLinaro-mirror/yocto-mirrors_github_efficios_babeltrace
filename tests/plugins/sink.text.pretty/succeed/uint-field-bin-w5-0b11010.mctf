--- metadata
/* CTF 1.8 */

trace {
    major = 1;
    minor = 8;
    byte_order = le;
};

event {
    name = "e";
    fields := struct {
        integer { size = 5; align = 8; signed = false; byte_order = le; base = binary; } v;
        integer { size = 3; align = 1; signed = false; byte_order = le; base = decimal; } pad;
    };
};

--- stream
%
 000
 11010

--- @output
e: { v = 0b11010, pad = 0 }
