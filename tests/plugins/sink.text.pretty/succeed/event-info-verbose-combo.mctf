--- metadata
/* CTF 1.8 */

trace {
    major = 1;
    minor = 8;
    byte_order = le;
};

env {
    hostname = "myhost";
};

event {
    name = "e";
    loglevel = 4;
    fields := struct {
        integer { size = 8; align = 8; signed = false; byte_order = le; base = hexadecimal; } v;
    };
};

--- stream
ab

--- @params
name-header=yes
field-trace=yes
field-trace:hostname=yes
field-loglevel=yes

--- @output
trace = myhost, trace:hostname = myhost, loglevel = TRACE_WARNING (4), name = e, { v = 0xAB }
