--- metadata
/* CTF 1.8 */

trace {
    major = 1;
    minor = 8;
    byte_order = le;
};

event {
    name = "e";
    fields := struct {
        enum : integer { size = 8; align = 8; signed = true; byte_order = le; base = decimal; } {
            NEG = -1,
            ZERO = 0,
            POS = 1
        } v;
    };
};

--- stream
$255

--- @output
e: { v = ( "NEG" : container = -1 ) }
