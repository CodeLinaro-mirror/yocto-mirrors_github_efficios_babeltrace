--- metadata
/* CTF 1.8 */

trace {
    major = 1;
    minor = 8;
    byte_order = le;
};

stream {
    event.header := struct {
        integer { size = 8; align = 8; signed = false; byte_order = le; } id;
    };
};

event {
    id = 0;
    name = "e";
    context := struct {
        integer { size = 8; align = 8; signed = false; byte_order = le; base = decimal; } sc;
    };
};

--- stream
$0 $3

--- @params
name-scope=yes

--- @output
e: event.context = { sc = 3 }
