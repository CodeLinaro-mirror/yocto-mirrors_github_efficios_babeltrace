--- metadata
/* CTF 1.8 */

trace {
    major = 1;
    minor = 8;
    byte_order = le;
};

event {
    name = "e";
    fields := struct {
        integer { size = 8; align = 8; signed = false; byte_order = le; base = decimal; } a;
        struct {} empty;
        integer { size = 8; align = 8; signed = false; byte_order = le; base = decimal; } b;
    };
};

--- stream
$1 $2

--- @output
e: { a = 1, empty = { }, b = 2 }
