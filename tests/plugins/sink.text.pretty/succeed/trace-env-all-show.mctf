--- metadata
/* CTF 1.8 */

trace {
    major = 1;
    minor = 8;
    byte_order = le;
};

env {
    hostname = "h1";
    domain = "kernel";
    procname = "ls";
    vpid = 1234;
};

event {
    name = "e";
    fields := struct {
        integer { size = 8; align = 8; signed = false; byte_order = le; base = hexadecimal; } v;
    };
};

--- stream
ab

--- @params
field-default=show
field-trace=no

--- @output
h1:kernel:ls:(1234) e: { v = 0xAB }
