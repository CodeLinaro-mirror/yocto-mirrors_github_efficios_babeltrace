--- metadata
/* CTF 1.8 */

trace {
    major = 1;
    minor = 8;
    byte_order = le;
};

event {
    name = "e";
    fields := struct {
        integer { size = 4; align = 8; signed = false; byte_order = le; base = hexadecimal; } v;
        integer { size = 4; align = 1; signed = false; byte_order = le; base = decimal; } pad;
    };
};

--- stream
0a

--- @output
e: { v = 0xA, pad = 0 }
