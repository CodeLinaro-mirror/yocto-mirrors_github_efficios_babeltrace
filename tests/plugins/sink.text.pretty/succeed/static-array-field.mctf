--- metadata
/* CTF 1.8 */

trace {
    major = 1;
    minor = 8;
    byte_order = le;
};

event {
    name = "e";
    fields := struct {
        integer { size = 8; align = 8; signed = false; byte_order = le; base = decimal; } v[3];
    };
};

--- stream
01 02 03

--- @output
e: { v = [ [0] = 1, [1] = 2, [2] = 3 ] }
