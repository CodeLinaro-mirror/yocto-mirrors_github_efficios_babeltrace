--- metadata
/* CTF 1.8 */

trace {
    major = 1;
    minor = 8;
    byte_order = le;
};

event {
    name = "e";
    fields := struct {
        integer { size = 7; align = 8; signed = false; byte_order = le; base = octal; } v;
        integer { size = 1; align = 1; signed = false; byte_order = le; base = decimal; } pad;
    };
};

--- stream
%
  0
  1111111

--- @output
e: { v = 0177, pad = 0 }
