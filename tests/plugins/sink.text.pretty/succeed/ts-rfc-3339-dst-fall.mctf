--- metadata
/* CTF 1.8 */


trace {
    major = 1;
    minor = 8;
    byte_order = le;
};

clock {
    name = c;
    freq = 1000000000;
    absolute = true;
    offset = 0;
    offset_s = 1352007000;
};

stream {
    event.header := struct {
        integer { size = 8; align = 8; signed = false; byte_order = le; } id;
        integer { size = 64; align = 8; signed = false; byte_order = le; map = clock.c.value; } timestamp;
    };
};

event {
    id = 0;
    name = "e";
    fields := struct {
        integer { size = 8; align = 8; signed = false; byte_order = le; base = hexadecimal; } v;
    };
};

--- stream
# event 1: 2012-11-04T05:30:00Z (first 01:30, EDT)
$0                 # `id`
[0:64le]           # `timestamp`
ab                 # `v`

# event 2: 2012-11-04T06:30:00Z (second 01:30, EST)
$0                 # `id`
[3600000000000:64le]   # `timestamp`
ab                 # `v`

--- @params
{
  "ts-format": {
    "type": "rfc-3339",
    "tz": "EST5EDT,M3.2.0,M11.1.0"
  }
}

--- @output
[2012-11-04T01:30:00.000000000-04:00] (+?.?????????) e: { v = 0xAB }
[2012-11-04T01:30:00.000000000-05:00] (+3600.000000000) e: { v = 0xAB }
