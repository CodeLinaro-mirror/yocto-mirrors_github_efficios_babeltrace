--- metadata
/* CTF 1.8 */


trace {
    major = 1;
    minor = 8;
    byte_order = le;
};

clock {
    name = c;
    freq = 1000000000;
    absolute = true;
    offset = 0;
    offset_s = 0;
};

stream {
    event.header := struct {
        integer { size = 8; align = 8; signed = false; byte_order = le; } id;
        integer { size = 64; align = 8; signed = false; byte_order = le; map = clock.c.value; } timestamp;
    };
};

event {
    id = 0;
    name = "e";
    fields := struct {
        integer { size = 8; align = 8; signed = false; byte_order = le; base = hexadecimal; } v;
    };
};

--- stream
$0        # `id`
[0:64le]  # `timestamp`
ab        # `v`

--- @params
clock-gmt=yes

--- @output
[00:00:00.000000000] (+?.?????????) e: { v = 0xAB }
