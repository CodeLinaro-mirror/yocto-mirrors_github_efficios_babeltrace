--- metadata
/* CTF 1.8 */

trace {
    major = 1;
    minor = 8;
    byte_order = le;
};

env {
    procname = "ls";
};

event {
    name = "e";
    fields := struct {
        integer { size = 8; align = 8; signed = false; byte_order = le; base = hexadecimal; } v;
    };
};

--- stream
ab

--- @params
field-default=hide
field-trace:procname=yes

--- @output
ls e: { v = 0xAB }
