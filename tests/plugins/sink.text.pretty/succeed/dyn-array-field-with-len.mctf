--- metadata
/* CTF 1.8 */

trace {
    major = 1;
    minor = 8;
    byte_order = le;
};

event {
    name = "e";
    fields := struct {
        integer { size = 8; align = 8; signed = false; byte_order = le; base = decimal; } len;
        integer { size = 8; align = 8; signed = false; byte_order = le; base = decimal; } v[len];
    };
};

--- stream
$3
$1 $2 $3

--- @output
e: { len = 3, v = [ [0] = 1, [1] = 2, [2] = 3 ] }
