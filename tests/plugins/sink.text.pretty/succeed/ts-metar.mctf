--- metadata
/* CTF 1.8 */


trace {
    major = 1;
    minor = 8;
    byte_order = le;
};

clock {
    name = c;
    freq = 1000000000;
    absolute = true;
    offset = 0;
    offset_s = 1351532897;
};

stream {
    event.header := struct {
        integer { size = 8; align = 8; signed = false; byte_order = le; } id;
        integer { size = 64; align = 8; signed = false; byte_order = le; map = clock.c.value; } timestamp;
    };
};

event {
    id = 0;
    name = "e";
    fields := struct {
        integer { size = 8; align = 8; signed = false; byte_order = le; base = hexadecimal; } v;
    };
};

--- stream
# event 1: 2012-10-29T17:48:17.587654321Z
$0                     # `id`
[587654321:64le]       # `timestamp`
ab                     # `v`

# event 2: 2012-10-29T17:53:42.123456789Z
$0                     # `id`
[325123456789:64le]    # `timestamp`
ab                     # `v`

# event 3: 2012-10-29T18:07:00Z
$0                     # `id`
[1123000000000:64le]   # `timestamp`
ab                     # `v`

--- @params
{
  "ts-format": {
    "type": "metar"
  }
}

--- @output
[291748Z] (+?.?????????) e: { v = 0xAB }
[291753Z] (+324.535802468) e: { v = 0xAB }
[291807Z] (+797.876543211) e: { v = 0xAB }
