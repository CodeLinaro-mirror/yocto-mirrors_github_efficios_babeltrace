--- metadata
/* CTF 1.8 */


trace {
    major = 1;
    minor = 8;
    byte_order = le;
};

clock {
    name = c;
    freq = 1000000000;
    absolute = true;
    offset = 0;
    offset_s = 1326628800;
};

stream {
    event.header := struct {
        integer { size = 8; align = 8; signed = false; byte_order = le; } id;
        integer { size = 64; align = 8; signed = false; byte_order = le; map = clock.c.value; } timestamp;
    };
};

event {
    id = 0;
    name = "e";
    fields := struct {
        integer { size = 8; align = 8; signed = false; byte_order = le; base = hexadecimal; } v;
    };
};

--- stream
# event 1: 2012-01-15T12:00:00Z (offset of clock class)
$0                          # `id`
[0:64le]                    # `timestamp`
ab                          # `v`

# event 2: 2012-07-15T12:00:00Z
$0                          # `id`
[15724800000000000:64le]    # `timestamp`
ab                          # `v`
