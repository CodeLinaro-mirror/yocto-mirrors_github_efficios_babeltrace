--- metadata
/* CTF 1.8 */

trace {
    major = 1;
    minor = 8;
    byte_order = le;
};

stream {
    packet.context := struct {
        integer { size = 64; align = 8; signed = false; byte_order = le; } packet_size;
        integer { size = 64; align = 8; signed = false; byte_order = le; } events_discarded;
    };
};

event {
    name = "e";
    fields := struct {
        integer { size = 8; align = 8; signed = false; byte_order = le; } v;
    };
};

--- stream
!le

!macro packet(ev_disc, v)
  <pkt_beg>
  [8 * (pkt_end - pkt_beg) : 64]  # `packet_size`
  [                ev_disc : 64]  # `events_discarded`
  [                      v :  8]  # `v`
  <pkt_end>
!end

m:packet(0, 0xaa)
m:packet(4, 0xbb)

--- @output
              2 Event messages
              1 Stream beginning message
              1 Stream end message
              2 Packet beginning messages
              2 Packet end messages
              1 Discarded event message
              0 Discarded packet messages
              0 Message iterator inactivity messages
              9 messages (TOTAL)
