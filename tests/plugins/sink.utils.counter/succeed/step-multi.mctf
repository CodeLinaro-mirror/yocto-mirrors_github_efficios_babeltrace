--- metadata
/* CTF 1.8 */

trace {
    major = 1;
    minor = 8;
    byte_order = le;
};

stream {
    packet.context := struct {
        integer { size = 64; align = 8; signed = false; byte_order = le; } packet_size;
    };
};

event {
    name = "e";
    fields := struct {
        integer { size = 8; align = 8; signed = false; byte_order = le; } v;
    };
};

--- stream
!le

!macro packet(v)
  <pkt_beg>
  [8 * (pkt_end - pkt_beg) : 64]  # `packet_size`
  [                      v :  8]  # `v`
  <pkt_end>
!end

m:packet(0x01) * 10

--- @params
step=10

--- @output
              5 Event messages
              1 Stream beginning message
              0 Stream end messages
              5 Packet beginning messages
              4 Packet end messages
              0 Discarded event messages
              0 Discarded packet messages
              0 Message iterator inactivity messages
             15 messages (TOTAL)

             10 Event messages
              1 Stream beginning message
              0 Stream end messages
             10 Packet beginning messages
              9 Packet end messages
              0 Discarded event messages
              0 Discarded packet messages
              0 Message iterator inactivity messages
