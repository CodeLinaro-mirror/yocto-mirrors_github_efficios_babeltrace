--- metadata
/* CTF 1.8 */

typealias integer { size = 8; align = 8; signed = false; } := uint8_t;
typealias integer { size = 32; align = 8; signed = false; } := uint32_t;

trace {
    major = 1;
    minor = 8;
    byte_order = le;
    packet.header := struct {
        uint32_t magic;
    };
};

stream {
    packet.context := struct {
        uint8_t packet_size;
        uint8_t content_size;
    };
};

event {
    name = "ev";
    fields := struct { uint8_t v; };
};

--- channel0
!le

# packet header
[     0xc1fc1fc1 : 32]  # `magic`

# packet context
[             33 : 8]   # `packet_size`
[             33 : 8]   # `content_size`

# event
00                      # `v`

--- @error
At 40 bits: expected total length of current packet (33 bits) isn't a multiple of 8 bits.
