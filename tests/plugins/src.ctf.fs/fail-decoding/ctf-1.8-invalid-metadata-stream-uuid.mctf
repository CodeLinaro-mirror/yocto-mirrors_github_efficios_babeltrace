--- metadata
/* CTF 1.8 */

typealias integer { size = 8; align = 8; signed = false; byte_order = le; } := uint8_t;
typealias integer { size = 32; align = 8; signed = false; byte_order = le; } := uint32_t;

trace {
    major = 1;
    minor = 8;
    uuid = "a8d0738a-4a6d-466b-83a7-8ab3c387d5bb";
    byte_order = le;
    packet.header := struct {
        uint32_t magic;
        uint8_t  uuid[16];
    };
};

stream {
    packet.context := struct {
        uint8_t content_size;
        uint8_t packet_size;
    };
};

event {
    name = "ev";
    fields := struct { uint8_t v; };
};

--- channel0
!le

<beg>
# packet header
[0xc1fc1fc1 : 32]                     # `magic`
f5f86ab3-ee0e-4318-8743-cdccb537404a  # `uuid`

# packet context
[8 * (end - beg) : 8]                 # `content_size`
[8 * (end - beg) : 8]                 # `packet_size`

# event
00                                    # `v`
<end>

--- @error
Invalid metadata stream UUID: uuid=f5f86ab3-ee0e-4318-8743-cdccb537404a, expected-uuid=a8d0738a-4a6d-466b-83a7-8ab3c387d5bb
