--- metadata
/* CTF 1.8 */

typealias integer { size = 8; align = 8; signed = false; } := uint8_t;
typealias integer { size = 32; align = 8; signed = false; } := uint32_t;

trace {
    major = 1;
    minor = 8;
    byte_order = le;
    packet.header := struct {
        uint32_t magic;
    };
};

stream {
    packet.context := struct {
        uint8_t content_size;
        uint8_t packet_size;
    };
};

event {
    name = "ev";
    fields := struct { uint32_t v; };
};

--- channel0
!le

<beg>
# packet header
[     0xc1fc1fc1 : 32]  # `magic`

# packet context
[8 * (end - beg) : 8]   # `content_size`
[8 * (end - beg) : 8]   # `packet_size`

# event
00                      # 1 of 4 expected bytes of `v`
<end>

--- @error
At 48 bits: 32 bits of packet content required at this point, but only 8 bits of packet content remain
